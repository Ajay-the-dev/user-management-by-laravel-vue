# Env for the static Netlify demo (vite --mode demo). Keeps the real .env,
# with its Cloudinary and Reverb keys, out of the public bundle.
# The API host is never contacted: demo/mock/api.js answers every request.
VITE_API_BASE_URL=https://demo.local/api
VITE_API_URL=https://demo.local
VITE_IMAGE_BASE_URL=
VITE_DOC_BASE_URL=
VITE_CURRENCY='₹'
VITE_FINYEAR='FY 2026'
VITE_PAYMENT='CASH,UPI,TRANSFER'
VITE_DEFAULT_USER_PASSWORD=
VITE_CLOUDINARY_CLOUD_NAME=demo
VITE_CLOUDINARY_IMAGE_UPLOAD_PRESET=demo
VITE_CLOUDINARY_DOC_UPLOAD_PRESET=demo
